{
  "buildCommand": "EXPO_PUBLIC_DOMAIN=$VERCEL_URL pnpm run build",
  "outputDirectory": "static-build",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "server/serve.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server/serve.js"
    }
  ]
}
